<?php
// Kurage 陳情・名簿 の設定。このファイルを kcm_config.php という名前で同じフォルダに置く（git には入れない）。
return [
    'office'      => '○○事務所',                                  // 事務所の名前（画面の上。設定画面でも変えられる）
    'db'          => __DIR__ . '/kcm_data/kchinjomeibo.sqlite',     // できれば公開フォルダの外（例: '/home/users/xxx/kcm_data/kchinjomeibo.sqlite'）
    'idle_min'    => 60,                                            // 無操作でログアウトする分
    'backup_days' => 30,                                            // 毎日の控えを残す日数
    'page_size'   => 50,
    'map'         => true,                                          // 地図を使う（地図の絵を OpenFreeMap から読む。名簿のデータは送らない）
    'geocode'     => true,                                          // 住所から地図の位置を付ける（住所の文字だけを国土地理院の住所検索に送る。false なら地図を押して決める）
    'ai_url'      => '',                                            // AI を使うとき：OpenAI 互換の /v1/chat/completions の URL（事務所内の Ollama など。空なら AI のボタンを出さない）
    'ai_token'    => '',
    'ai_model'    => 'gemma4',
    'demo'        => false,                                         // 本番は必ず false
];
